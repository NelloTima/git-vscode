# Copy to .env and fill in. Never commit the real .env.
# Both apps read this file; give each its own values in production (separate servers/containers).
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
WHATSAPP_NUMBER=258840000000
SUPPORT_PHONE=+258 84 000 0000
BANK_DETAILS=BCI · NIB 0008 0000 0000 0000 0000 0 · Titular: <empresa>

# Where each site lives (used for the links between them)
VIAJAMOZ_URL=http://localhost:5001
ALUGAMOZ_URL=http://localhost:5002
# Database files (default: viajamoz.db / alugamoz.db in the repo root)
# VIAJAMOZ_DB=/var/lib/viajamoz/viajamoz.db
# ALUGAMOZ_DB=/var/lib/alugamoz/alugamoz.db

# AI assistants (Claude). Without a key, simple rule-based assistants answer.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Vodacom M-Pesa Open API (C2B). Without these, mobile payments are simulated.
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
# MPESA_BASE_URL=https://api.sandbox.vm.co.mz:18352

# ViajaMoz demo only: show part of each bus as sold. MUST be 0 in production.
DEMO_FILL=1
# HTTPS=1   # send session cookies only over HTTPS (set in production)
